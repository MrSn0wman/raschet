# --- SMTP для обратной связи ---
# Оставьте SMTP_HOST пустым — письма отправляться не будут,
# обращения сохранятся в БД, в лог уйдёт только мета-запись.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# От кого (по умолчанию = SMTP_USER):
SMTP_FROM=
# Куда слать обращения:
FEEDBACK_TO=

# --- Прочее ---
# Дополнительные CORS-origins через запятую (прод-домен фронта добавлен в коде):
# CORS_ORIGINS=https://raschet.example,https://www.raschet.example
CORS_ORIGINS=

# Путь к SQLite (по умолчанию ./data/app.db рядом с кодом):
# DB_PATH=/opt/raschet-backend/data/app.db
DB_PATH=
